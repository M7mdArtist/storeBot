# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here
# Optional: Set GUILD_ID for instant slash-command sync in a single server, leave blank for global commands
GUILD_ID=

# Local MySQL Database Connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=discord_store_bot

# Bot Defaults (overridable per-server inside Discord via /language and /prefix)
DEFAULT_PREFIX=+
DEFAULT_LANGUAGE=ar
